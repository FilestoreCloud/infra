#!/usr/bin/env bash
# ==============================================================================
# Git Hook: pre-commit
# Purpose: Prevent direct commits to protected branches, verify staged security,
#          and run code quality & DevSecOps checks via pre-commit.
# ==============================================================================

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/helpers/colors.sh"
source "$HOOK_DIR/helpers/git-env.sh"
source "$HOOK_DIR/helpers/security-guard.sh"

CURRENT_BRANCH=$(get_current_branch)

# ------------------------------------------------------------------------------
# 1. Branch Protection Check
# ------------------------------------------------------------------------------
if [ "${ALLOW_DIRECT_MAIN:-0}" != "1" ] && [ "${SKIP_BRANCH_PROTECTION:-0}" != "1" ]; then
  if is_protected_branch "$CURRENT_BRANCH"; then
    log_error "Direct commits to protected branch '$CURRENT_BRANCH' are forbidden!"
    printf "\n"
    printf "  ${COLOR_BOLD}Recommended workflow:${COLOR_RESET}\n"
    printf "    1. Create a feature branch: ${COLOR_CYAN}git checkout -b feat/your-feature-name${COLOR_RESET}\n"
    printf "    2. Commit changes and push to origin\n"
    printf "    3. Open a Pull Request for review\n\n"
    printf "  ${COLOR_GRAY}(To bypass in an emergency, set ALLOW_DIRECT_MAIN=1 git commit ...)${COLOR_RESET}\n\n"
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# 2. Staged Security & Hygiene Scan
# ------------------------------------------------------------------------------
log_step "Checking staged files for secrets and conflict markers..."
if ! check_staged_security; then
  exit 1
fi
log_success "Staged files hygiene scan passed."

# ------------------------------------------------------------------------------
# 3. Code Quality & DevSecOps Linters (Pre-Commit Enforcement)
# ------------------------------------------------------------------------------
log_step "Running code quality checks: YAML linting (yamllint)..."
if command -v yamllint >/dev/null 2>&1; then
  if ! yamllint -d "{extends: relaxed, rules: {line-length: {max: 240}, indentation: {spaces: 2}}}" \
    infra/modules/ infra/root.yaml infra/environments/; then
    log_error "YAML linting failed. Fix YAML formatting before committing."
    exit 1
  fi
  log_success "YAML linting passed."
else
  log_warn "yamllint not found in PATH, skipping YAML lint."
fi

log_step "Running CloudFormation linting (cfn-lint)..."
if command -v cfn-lint >/dev/null 2>&1; then
  if ! cfn-lint --config-file .devsecops/.cfnlintrc.yaml infra/modules/*/template.yaml infra/root.yaml; then
    log_error "cfn-lint validation failed. Fix CloudFormation errors before committing."
    exit 1
  fi
  log_success "CloudFormation linting passed."
else
  log_error "cfn-lint command not found. Please install cfn-lint (brew install cfn-lint or pip install cfn-lint)."
  exit 1
fi

log_step "Validating CloudFormation template syntax with Python YAML parser..."
if ! python3 -c "
import yaml, glob
class CfnLoader(yaml.SafeLoader): pass
def ctor(l, s, n): return l.construct_scalar(n) if isinstance(n, yaml.ScalarNode) else (l.construct_sequence(n) if isinstance(n, yaml.SequenceNode) else l.construct_mapping(n))
CfnLoader.add_multi_constructor('!', ctor)
files = glob.glob('infra/modules/*/template.yaml') + ['infra/root.yaml']
for f in files:
    yaml.load(open(f), Loader=CfnLoader)
    print(f'  ✓ Validated {f}')
"; then
  log_error "CloudFormation template YAML syntax validation failed!"
  exit 1
fi
log_success "CloudFormation YAML syntax validation passed."

log_step "Running Python unit test suite (pytest tests/)..."
if command -v pytest >/dev/null 2>&1; then
  if ! pytest tests/ -v; then
    log_error "Pytest test suite failed. Fix failing tests before committing."
    exit 1
  fi
  log_success "Pytest test suite passed successfully."
else
  log_error "pytest command not found. Please install pytest."
  exit 1
fi

log_success "All local code quality standards verified successfully. Proceeding with commit."
exit 0
