# ==============================================================================
# Amazon RDS PostgreSQL Security & Protection Rules
# ==============================================================================

let rds_instances = Resources.*[ Type == 'AWS::RDS::DBInstance' ]

rule RDS_STORAGE_ENCRYPTED when %rds_instances !empty {
    %rds_instances.Properties.StorageEncrypted == true <<RDS instances must have StorageEncrypted set to true.>>
}

rule RDS_NOT_PUBLICLY_ACCESSIBLE when %rds_instances !empty {
    %rds_instances.Properties.PubliclyAccessible == false <<RDS instances must not be publicly accessible (PubliclyAccessible must be false).>>
}

rule RDS_DELETION_POLICY when %rds_instances !empty {
    %rds_instances.DeletionPolicy in ['Snapshot', 'Retain'] <<RDS instances must have DeletionPolicy set to Snapshot or Retain.>>
}
