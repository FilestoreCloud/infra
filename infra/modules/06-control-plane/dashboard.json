{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 3,
      "properties": {
        "markdown": "# ☁️ Nextcloud Enterprise — SaaS Control Plane Telemetry\n**Region:** ap-southeast-1 | **Environment:** prod | **Tenant Registry:** prod-nextcloud-tenant-registry"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "All Tenants — Storage Utilization (MB)",
        "metrics": [
          [
            {
              "expression": "SEARCH('{Nextcloud/SaaS,TenantId} MetricName=\"TenantStorageUsedMB\"', 'Average', 300)",
              "id": "storage",
              "label": "${PROP('Dim.TenantId')}"
            }
          ]
        ],
        "period": 300,
        "region": "ap-southeast-1",
        "view": "timeSeries",
        "yAxis": { "left": { "label": "MB Used" } }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "All Tenants — Lifecycle Status (1=ACTIVE, 0=SUSPENDED)",
        "metrics": [
          [
            {
              "expression": "SEARCH('{Nextcloud/SaaS,TenantId} MetricName=\"TenantActiveStatus\"', 'Maximum', 300)",
              "id": "status",
              "label": "${PROP('Dim.TenantId')}"
            }
          ]
        ],
        "period": 300,
        "region": "ap-southeast-1",
        "view": "timeSeries",
        "yAxis": { "left": { "label": "Status", "min": 0, "max": 1 } }
      }
    }
  ]
}
